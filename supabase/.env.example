# Edge function secrets — Healing Partners
#
# Copy to supabase/.env, fill in, and push to the project:
#
#     supabase secrets set --env-file supabase/.env
#
# These are read by Deno.env.get() inside supabase/functions/*. They never
# reach the browser. SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected by the platform at runtime and must
# NOT be set here.

# interview, classify-story — the model calls
ANTHROPIC_API_KEY=

# interview, classify-story, media-sign — CORS allowlist, comma separated.
# Every origin that serves the pages, with no trailing slash.
ALLOWED_ORIGINS=https://healingpartners.us,http://localhost:8000

# media-sign — Cloudflare R2, where photographs and proofs live
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
